# Backend API Base URL
VITE_API_URL=http://localhost:5000

# Optional: Network or Public App URL for mobile QR code scanning (e.g., http://192.168.1.5:5173)
VITE_APP_URL=http://localhost:5173

# Supabase Authentication & Database Integration
# Obtain from your Supabase project dashboard: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
