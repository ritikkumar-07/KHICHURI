PORT=5000
NODE_ENV=development
SERVICE_NAME=sanjeevani-api
LOG_LEVEL=info
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=
MONGODB_URI=
GROQ_API_KEY=
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Local/demo only. In production, missing MongoDB or Supabase configuration
# prevents startup unless ALLOW_MEMORY_DB=true is explicitly set.
ALLOW_MEMORY_DB=false

# Demo fixtures and demo bearer tokens (demo-token / demo-admin-token) are
# enabled automatically outside production when Supabase is not configured.
# Never enable this on a public production deployment.
ALLOW_DEMO_AUTH=false

# Rate limiting is in-process. Disable only for controlled load tests.
RATE_LIMIT_ENABLED=true

# Set to 1 only when running behind exactly one trusted reverse proxy.
TRUST_PROXY=false
